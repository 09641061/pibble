# Copy to .env for the prod profile. Dev and test start PostgreSQL through Dev Services.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pibble
DATABASE_USER=pibble
DATABASE_PASSWORD=change-me

# Email (Resend) for sign-in codes
EMAIL_FROM=Takodu <no-reply@example.com>
RESEND_API_KEY=

# Access-token signing keys (PEM files): openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem && openssl pkey -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_LOCATION=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_LOCATION=/run/secrets/jwt-public.pem

# Web app base URL, used in invitation links
APP_URL=https://app.takodu.com
